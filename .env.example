# Copy this file to .env and fill in the values. Lines starting with # are ignored.

# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Application (client) ID from the same page -> General Information
DISCORD_CLIENT_ID=
# Optional: register the slash commands only in this server (instant) instead of
# globally (can take up to an hour to show up). Leave empty for global.
DISCORD_GUILD_ID=

# --- Foundry VTT ------------------------------------------------------------
# Where the bot can reach Foundry. Use the local address, not the public one.
FOUNDRY_URL=http://localhost:30000
# Foundry's user data folder (the one containing Config/, Data/ and Logs/).
# Needed for update tracking of systems and modules and for world titles.
#   Linux:   /home/<user>/.local/share/FoundryVTT  or  /home/<user>/foundrydata
#   Windows: C:\Users\<user>\AppData\Local\FoundryVTT
FOUNDRY_DATA_PATH=
# Optional: Foundry's install folder (containing resources/app/package.json).
# Lets the bot report the installed Foundry version even while Foundry is down.
FOUNDRY_APP_PATH=
# Optional: where the Foundry module dxcufgbs-session-summary writes its session
# summaries, if you changed its "Export folder" setting. Absolute, or relative to
# Foundry's Data folder (like the module's setting). Default: session-summaries in
# the Data folder. A missing folder is fine: the bot works without the module.
SESSION_SUMMARY_DIR=
# Where /updates available and /updates compatibility look for new releases
# (the package API and the release notes). Only change this for a mirror.
FOUNDRY_WEBSITE_URL=https://foundryvtt.com

# --- Bot --------------------------------------------------------------------
# Where the bot stores its settings and what it has already announced.
BOT_DATA_DIR=./data
# How often to check Foundry, in seconds.
POLL_INTERVAL_SECONDS=30
# How many checks in a row must fail before Foundry counts as down.
DOWN_AFTER_FAILURES=2
# Timezone used for restart windows and in messages (IANA name).
TIMEZONE=UTC
# Log level: debug, info, warn, error
LOG_LEVEL=info
# After the bot was updated, DM the changelog to: admins (each server's owner and
# every member with Administrator), owner, or off. admins needs the Server Members Intent
# (Developer Portal -> Bot -> Privileged Gateway Intents); without it the bot logs a warning
# and sends notices to owners only. owner and off do not request it.
UPDATE_NOTIFY=admins

# --- Administration page (optional) -----------------------------------------
# A password-protected web page to see the bot's state and change its settings.
# Off unless ADMIN_PORT is set; it also needs a password: npm run admin-password
# (or: sudo node scripts/admin-password.js in the install folder). Restart the bot after.
ADMIN_PORT=
# Address to listen on (default 0.0.0.0 = every network interface).
#ADMIN_HOST=0.0.0.0
# HTTPS with a self-signed certificate made once in BOT_DATA_DIR (admin-tls.crt/.key).
# Use your own with ADMIN_TLS_CERT / ADMIN_TLS_KEY, or ADMIN_TLS=off behind a reverse
# proxy that does HTTPS.
#ADMIN_TLS_CERT=
#ADMIN_TLS_KEY=
#ADMIN_TLS=off
# More host names the page may be opened with (comma separated); localhost and this
# machine's names and addresses always work.
#ADMIN_HOSTS=bot.example.com
# Trust X-Forwarded-* from a reverse proxy: 1 = one on this machine, or its addresses.
#ADMIN_TRUST_PROXY=1
