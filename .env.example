# Copy this file to .env and fill in the values. Lines starting with # are ignored.

# --- Discord -----------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Application (client) ID from the same page -> General Information
DISCORD_CLIENT_ID=
# Optional: register the slash commands only in this server (instant) instead of
# globally (can take up to an hour to show up). Leave empty for global.
DISCORD_GUILD_ID=

# --- Foundry VTT ------------------------------------------------------------
# Where the bot can reach Foundry. Use the local address, not the public one.
FOUNDRY_URL=http://localhost:30000
# Foundry's user data folder (the one containing Config/, Data/ and Logs/).
# Needed for update tracking of systems and modules and for world titles.
#   Linux:   /home/<user>/.local/share/FoundryVTT  or  /home/<user>/foundrydata
#   Windows: C:\Users\<user>\AppData\Local\FoundryVTT
FOUNDRY_DATA_PATH=
# Optional: Foundry's install folder (containing resources/app/package.json).
# Lets the bot report the installed Foundry version even while Foundry is down.
FOUNDRY_APP_PATH=

# --- Bot --------------------------------------------------------------------
# Where the bot stores its settings and what it has already announced.
BOT_DATA_DIR=./data
# How often to check Foundry, in seconds.
POLL_INTERVAL_SECONDS=30
# How many checks in a row must fail before Foundry counts as down.
DOWN_AFTER_FAILURES=2
# Timezone used for restart windows and in messages (IANA name).
TIMEZONE=UTC
# Log level: debug, info, warn, error
LOG_LEVEL=info
