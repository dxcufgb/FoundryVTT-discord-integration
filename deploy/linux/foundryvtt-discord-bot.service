# systemd unit for the Foundry VTT Discord integration.
# Installed by deploy/linux/install.sh, which fills in the placeholders.
# Run as the same user that runs Foundry so the bot can read Foundry's data folder.

[Unit]
Description=Foundry VTT Discord integration
Documentation=https://github.com/dxcufgb/FoundryVTT-discord-integration#readme
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=__INSTALL_DIR__/.env
ExecStart=__NODE__ src/index.js
Restart=on-failure
RestartSec=10
# Hardening: the bot only needs to read Foundry's folder and write its own data/ folder.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__INSTALL_DIR__/data

[Install]
WantedBy=multi-user.target
